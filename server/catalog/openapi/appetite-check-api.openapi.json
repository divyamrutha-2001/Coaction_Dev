      "post": {
        "operationId": "appetite-check-api",
        "summary": "Evaluates whether a submission fits underwriting appetite and whether referral is required.",
        "tags": [
          "Production",
          "REST",
          "Underwriting & Submissions"
        ],
        "parameters": [],
        "responses": {
