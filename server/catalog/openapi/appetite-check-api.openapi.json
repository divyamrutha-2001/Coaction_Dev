            "description": "Use this before quoting to confirm whether an account fits underwriting appetite.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "appetite": {
                      "type": "string",
                      "example": "ACCEPTABLE"
                    },
                    "score": {
                      "type": "integer",
                      "example": 84
                    },
                    "referralRequired": {
                      "type": "boolean",
                      "example": false
                    },
                    "reasons": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "required": [
                    "appetite",
                    "score",
                    "referralRequired",
                    "reasons"
                  ]
                },
                "example": {
                  "appetite": "ACCEPTABLE",
                  "score": 84,
                  "referralRequired": false,
                  "reasons": []
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "lineOfBusiness": {
                    "type": "string",
                    "example": "General Liability"
                  },
                  "industry": {
                    "type": "string",
                    "example": "Manufacturing"
                  },
                  "naicsCode": {
                    "type": "string",
                    "example": "332710"
                  },
                  "state": {
                    "type": "string",
                    "example": "NJ"
                  },
                  "annualRevenue": {
                    "type": "integer",
                    "example": 25000000
                  },
                  "priorLossCount": {
                    "type": "integer",
                    "example": 2
                  }
                },
                "required": [
                  "lineOfBusiness",
                  "industry",
                  "naicsCode",
                  "state"
                ]
              },
              "example": {
                "lineOfBusiness": "General Liability",
                "industry": "Manufacturing",
                "naicsCode": "332710",
                "state": "NJ",
                "annualRevenue": 25000000,
                "priorLossCount": 2
              }
            }
          }
        }
      }
    }
  }
}
