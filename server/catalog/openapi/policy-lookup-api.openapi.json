  "info": {
    "title": "Policy Lookup API",
    "version": "v1.0",
    "description": "Retrieves the current policy header, insured, term and premium information.",
    "x-domain": "Policy Administration",
    "x-owner": "Policy Administration Team",
    "x-lifecycle": "Published",
    "x-consumers": 6,
    "x-document": {
      "purpose": "Retrieves the current policy header, insured, term and premium information.",
