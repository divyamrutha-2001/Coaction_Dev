      "get": {
        "operationId": "policy-lookup-api",
        "summary": "Retrieves the current policy header, insured, term and premium information.",
        "tags": [
          "Production",
          "REST",
          "Policy Administration"
        ],
        "parameters": [
          {
            "name": "policyNumber",
            "in": "path",
            "required": true,
            "description": "policyNumber identifies the record you want.",
            "schema": {
              "type": "string",
              "example": "POL-2026-98765"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Use this to retrieve current policy-level details.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "policyNumber": {
                      "type": "string",
                      "example": "POL-2026-98765"
                    },
                    "insuredName": {
                      "type": "string",
                      "example": "Acme Manufacturing Inc."
                    },
                    "lineOfBusiness": {
                      "type": "string",
                      "example": "General Liability"
                    },
                    "effectiveDate": {
                      "type": "string",
                      "example": "2026-10-01"
                    },
                    "expirationDate": {
                      "type": "string",
                      "example": "2027-10-01"
                    },
                    "status": {
                      "type": "string",
                      "example": "ACTIVE"
                    },
                    "writtenPremium": {
                      "type": "integer",
                      "example": 185000
                    }
                  },
                  "required": [
                    "policyNumber",
                    "insuredName",
                    "lineOfBusiness",
                    "effectiveDate",
                    "expirationDate",
                    "status",
                    "writtenPremium"
                  ]
                },
                "example": {
                  "policyNumber": "POL-2026-98765",
                  "insuredName": "Acme Manufacturing Inc.",
                  "lineOfBusiness": "General Liability",
                  "effectiveDate": "2026-10-01",
                  "expirationDate": "2027-10-01",
                  "status": "ACTIVE",
                  "writtenPremium": 185000
                }
              }
            }
          }
        }
      }
    }
