                            "example": "100 Industrial Way, Newark, NJ"
                          },
                          "classCode": {
                            "type": "string",
                            "example": "91580"
                          },
                          "payroll": {
                            "type": "integer",
                            "example": 4200000
                          },
                          "employeeCount": {
                            "type": "integer",
                            "example": 85
                          }
                        },
                        "required": [
                          "locationId",
                          "address",
                          "classCode",
                          "payroll",
                          "employeeCount"
                        ]
                      }
                    }
                  },
                  "required": [
                    "policyNumber",
                    "exposures"
                  ]
                },
                "example": {
                  "policyNumber": "POL-2026-98765",
                  "exposures": [
                    {
                      "locationId": "LOC-001",
                      "address": "100 Industrial Way, Newark, NJ",
                      "classCode": "91580",
                      "payroll": 4200000,
                      "employeeCount": 85
                    },
                    {
                      "locationId": "LOC-002",
                      "address": "25 Commerce Drive, Edison, NJ",
                      "classCode": "91580",
                      "payroll": 3100000,
                      "employeeCount": 62
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
