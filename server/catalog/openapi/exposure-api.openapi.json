            "description": "Use this to retrieve policy exposure locations and rating characteristics.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "policyNumber": {
                      "type": "string",
                      "example": "POL-2026-98765"
