        {
          "name": "priorLossAmount",
          "type": "integer",
          "required": false,
          "description": "Total prior loss amount used in risk scoring.",
          "example": "425000"
        },
        {
          "name": "yearsInBusiness",
          "type": "integer",
          "required": false,
          "description": "Number of years the insured has been operating.",
          "example": "12"
