  "paths": {
    "/api/v1/reference/class-codes": {
      "get": {
        "operationId": "reference-data-api",
        "summary": "Provides governed reference values such as class codes, coverage codes, territories and state-specific values.",
        "tags": [
          "Production",
          "REST",
          "Actuarial Pricing & Modeling"
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "Use this to retrieve approved class codes and reference values.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "lineOfBusiness": {
                      "type": "string",
                      "example": "Workers Compensation"
                    },
                    "state": {
                      "type": "string",
                      "example": "NJ"
                    },
                    "classCodes": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "code": {
                            "type": "string",
                            "example": "8810"
                          },
                          "description": {
                            "type": "string",
                            "example": "Clerical Office Employees"
                          },
                          "effectiveDate": {
                            "type": "string",
                            "example": "2026-01-01"
                          }
                        },
                        "required": [
                          "code",
                          "description",
                          "effectiveDate"
                        ]
                      }
                    }
                  },
                  "required": [
                    "lineOfBusiness",
                    "state",
                    "classCodes"
                  ]
                },
                "example": {
                  "lineOfBusiness": "Workers Compensation",
                  "state": "NJ",
                  "classCodes": [
                    {
                      "code": "8810",
                      "description": "Clerical Office Employees",
                      "effectiveDate": "2026-01-01"
                    },
                    {
                      "code": "8742",
                      "description": "Outside Sales Employees",
                      "effectiveDate": "2026-01-01"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
