        {
          "name": "classCodes[].description",
          "type": "string",
          "required": true,
          "description": "Human-readable description of the record or event.",
          "example": "Clerical Office Employees"
        },
        {
          "name": "classCodes[].effectiveDate",
          "type": "date string",
