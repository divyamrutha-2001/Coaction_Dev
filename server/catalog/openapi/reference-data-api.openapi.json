    "x-document": {
      "purpose": "Provides governed reference values such as class codes, coverage codes, territories and state-specific values.",
      "whenToUse": "Use this to retrieve approved class codes and reference values.",
      "notes": [
        "Reference data is generally read-only.",
        "Consumers should cache stable reference values where allowed."
      ],
      "errors": [
        "Unsupported state",
        "Unsupported line of business"
      ],
      "owner": "Actuarial Pricing & Modeling Team"
    },
    "x-explanations": {
      "Business": {
        "summary": "Retrieves the current lookup tables for class codes, coverage codes, and territories.",
        "evaluates": [
          "Reference type (class, coverage, territory)"
        ],
        "returns": [
          "List of valid codes and descriptions",
          "Effective and expiration dates for each"
        ]
      },
      "Developer": {
        "summary": "Serves reference data for form dropdowns. Cached and ETag-validated. Returns 304 if unchanged.",
        "evaluates": [
          "Query parameters for filtering"
        ],
        "returns": [
          "HTTP 200 with reference array",
          "Cache-Control: max-age=86400"
        ]
      },
      "Partner": {
        "summary": "Get lookup tables for class codes, coverage types, and territories.",
        "evaluates": [
          "Reference type requested"
        ],
        "returns": [
          "List of codes and labels"
        ]
      }
    },
    "x-fields": {
      "pathParameters": [],
      "request": [],
      "response": [
        {
          "name": "lineOfBusiness",
          "type": "string",
          "required": true,
          "description": "Insurance line of business for the request or response.",
          "example": "Workers Compensation"
        },
        {
          "name": "state",
          "type": "string",
          "required": true,
          "description": "US state for rating, appetite, exposure, or reference-data lookup.",
          "example": "NJ"
        },
        {
          "name": "classCodes",
          "type": "object[]",
          "required": true,
          "description": "Class-code records returned for the requested line of business and state.",
          "example": "[{\"code\":\"8810\",\"description\":\"Clerical Office Employees\",\"effectiveDate\":\"2026-01-01\"},{\"code\":\"8742\",\"description\":\"Outside Sales Employees\",\"effectiveDate\":\"2026-01-01\"}]"
        },
        {
          "name": "classCodes[].code",
          "type": "string",
          "required": true,
          "description": "Reference-data code value.",
